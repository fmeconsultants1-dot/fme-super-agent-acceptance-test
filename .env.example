# FME Acceptance Test — Environment Template
# Copy to .env and fill in values. NEVER commit .env to Git.

# Application
NODE_ENV=development
PORT=3000

# Database
# SQLite path relative to project root
DB_PATH=./data/fme_test.db

# External API — Provider A (Open-Meteo, no key required)
WEATHER_PROVIDER=open-meteo
WEATHER_LAT=49.2827
WEATHER_LON=-123.1207
WEATHER_LOCATION_NAME=Vancouver

# External API — Provider B (OpenWeatherMap, requires API key)
# INTEGRATION_PENDING: obtain key from https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# Job Runner
JOB_RETRY_MAX=3
JOB_RETRY_DELAY_MS=1000
